# MUHR configuration. Copy to .env (never commit .env). Every component loads the repo-root .env.

# ---- Mode ----
# true  = no sats move (synthetic invoices, dev keys allowed). Default.
# false = MDK Agent Wallet on buyer and sellers (needs Node/npx + an initialised, funded wallet).
DEMO_MODE=true
# MDK_AGENT_WALLET_PACKAGE=@moneydevkit/agent-wallet@0.22.0   # pinned; never use @latest

# ---- URLs ----
MUHR_REGISTRY_BASE_URL=http://127.0.0.1:8000
# MUHR_REGISTRY_INTERNAL_URL=http://127.0.0.1:8000   # what the registry uses to call itself (live demo)
MUHR_SELLER_SUMMARIZER_URL=http://127.0.0.1:8001
MUHR_SELLER_CLASSIFIER_URL=http://127.0.0.1:8002
MUHR_SELLER_URDU_URL=http://127.0.0.1:8003
# MUHR_CORS_ALLOW_ORIGINS=https://your.public.domain
# MUHR_TRUST_PROXY=false        # true only behind your own reverse proxy (compose sets it)

# ---- Auth (REQUIRED when DEMO_MODE=false; DEMO falls back to insecure dev keys) ----
# Shared secret between the registry and each built-in seller process.
# MUHR_SELLER_KEY_SEL_SUMMARIZER=change-me-long-random
# MUHR_SELLER_KEY_SEL_CLASSIFIER=change-me-long-random
# MUHR_SELLER_KEY_SEL_URDU=change-me-long-random
# Operator key for approval decisions and (outside DEMO) crediting verified stake.
# MUHR_ADMIN_KEY=change-me-long-random
# Set true on any internet-facing deployment, even in DEMO mode: the registry and sellers then
# refuse to start without MUHR_ADMIN_KEY and the seller keys above.
# MUHR_PUBLIC_DEPLOY=false

# ---- Registry ----
# DATABASE_URL=sqlite:///./muhr.db
# MUHR_SEED_DEMO_DATA=true
# MUHR_ALLOW_UNVERIFIED_SELLERS=false
# MUHR_VERIFIED_DOCKER_IMAGE_HASHES=sha256:...,sha256:...
# MUHR_ALLOW_UNVERIFIED_STAKE=false
# MUHR_FALLBACK_BTC_PKR=25000000   # shown only if the rate API has never answered (display only)
# MUHR_EXPOSE_BUYER_WALLET=false   # local demos only: lets the dashboard show a co-located buyer wallet

# ---- Sellers ----
# Hosted LLMs see the decrypted input. Leave everything below empty for the offline pipeline.
# Any OpenAI-compatible API, with several keys that take turns. Put the keys on one line, separated
# by commas, no spaces. A job moves to the next key on a rate limit (429), a server error or a
# timeout; a rejected key (401/403) is dropped until the sellers restart. Check them with:
#   python scripts/check_llm.py
LLM_BASE_URL=
LLM_API_KEYS=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low        # for reasoning models (gpt-oss defaults to low); "none" to leave it out
# LLM_TIMEOUT_SECONDS=20          # per attempt
# LLM_TOTAL_BUDGET_SECONDS=60     # most one job spends across keys
# LLM_COOLDOWN_SECONDS=60         # how long a rate-limited key rests if the provider gives no time
# Older single-key settings still work and are tried after the list above:
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# MUHR_SELLER_ISOLATION=none       # docker = run each job in a --network none container
# MUHR_SELLER_X25519_PRIVATE_B64=  # stable input-decryption key (random per start if unset)
# Run one seller on a local model in LM Studio (Developer tab: start the local server).
# Its jobs never reach a hosted provider, and it is shown as "Private" in the dashboard.
# If LM Studio is unreachable the job fails; it never falls back to a hosted API.
# MUHR_SELLER_SEL_URDU_LLM=lmstudio
# MUHR_LMSTUDIO_URL=http://127.0.0.1:1234/v1
# MUHR_LMSTUDIO_MODEL=your-loaded-model-name
# MUHR_L402_SECRET=                # stable macaroon signing secret (random per start if unset)

# ---- Buyer MCP ----
# MUHR_DAILY_BUDGET_SATS=10000
# MUHR_ENABLE_LIGHTNING_SEND=false   # true exposes the lightning_send tool (moves the buyer's own funds)
# MUHR_BUDGET_STATE=~/.muhr/budget.json

# ---- MUHR Nexus (front-end/muhr-nexus/.env*) ----
# VITE_API_BASE_URL=http://127.0.0.1:8000   # empty = same origin (Vite proxy / nginx)
