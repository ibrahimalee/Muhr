# MUHR configuration. Copy to .env (never commit .env). Every component loads the repo-root .env.

# ---- Mode ----
# true  = no sats move (synthetic invoices, dev keys allowed). Default.
# false = MDK Agent Wallet on buyer and sellers (needs Node/npx + an initialised, funded wallet).
DEMO_MODE=true
# MDK_AGENT_WALLET_PACKAGE=@moneydevkit/agent-wallet@0.22.0   # pinned; never use @latest

# ---- URLs ----
MUHR_REGISTRY_BASE_URL=http://127.0.0.1:8000
# MUHR_REGISTRY_INTERNAL_URL=http://127.0.0.1:8000   # what the registry uses to call itself (live demo)
MUHR_SELLER_SUMMARIZER_URL=http://127.0.0.1:8001
MUHR_SELLER_CLASSIFIER_URL=http://127.0.0.1:8002
# MUHR_CORS_ALLOW_ORIGINS=https://your.public.domain
# MUHR_TRUST_PROXY=false        # true only behind your own reverse proxy (compose sets it)

# ---- Auth (REQUIRED when DEMO_MODE=false; DEMO falls back to insecure dev keys) ----
# Shared secret between the registry and each built-in seller process.
# MUHR_SELLER_KEY_SEL_SUMMARIZER=change-me-long-random
# MUHR_SELLER_KEY_SEL_CLASSIFIER=change-me-long-random
# Operator key for approval decisions and (outside DEMO) crediting verified stake.
# MUHR_ADMIN_KEY=change-me-long-random

# ---- Registry ----
# DATABASE_URL=sqlite:///./muhr.db
# MUHR_SEED_DEMO_DATA=true
# MUHR_ALLOW_UNVERIFIED_SELLERS=false
# MUHR_VERIFIED_DOCKER_IMAGE_HASHES=sha256:...,sha256:...
# MUHR_ALLOW_UNVERIFIED_STAKE=false
# MUHR_EXPOSE_BUYER_WALLET=false   # local demos only: lets the dashboard show a co-located buyer wallet

# ---- Sellers ----
# Hosted LLMs see the decrypted input. Leave both empty for the offline pipeline.
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# MUHR_SELLER_ISOLATION=none       # docker = run each job in a --network none container
# MUHR_SELLER_X25519_PRIVATE_B64=  # stable input-decryption key (random per start if unset)
# MUHR_L402_SECRET=                # stable macaroon signing secret (random per start if unset)

# ---- Buyer MCP ----
# MUHR_DAILY_BUDGET_SATS=10000
# MUHR_BUDGET_STATE=~/.muhr/budget.json

# ---- MUHR Nexus (front-end/muhr-nexus/.env*) ----
# VITE_API_BASE_URL=http://127.0.0.1:8000   # empty = same origin (Vite proxy / nginx)
