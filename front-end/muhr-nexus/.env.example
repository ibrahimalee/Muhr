# Registry base URL. In dev, prefer pointing at the real registry so long /api/demo/* calls
# are not cut off by the Vite proxy (see .env.development).
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Optional: a Spline scene (.splinecode URL from spline.design, Export > Code > Vanilla JS)
# shown behind the 3D envelope in the opening story. Scrolling turns it with the story.
# The Spline runtime is only downloaded when this is set.
# VITE_SPLINE_SCENE=https://prod.spline.design/<scene-id>/scene.splinecode
