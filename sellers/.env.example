# Sellers read the repo-root .env. See ../.env.example for every option.
# Hosted LLM providers (they receive the decrypted input). Leave empty for offline processing.
# Several keys that take turns (see ../.env.example), then the older single-key settings.
LLM_BASE_URL=
LLM_API_KEYS=
GROQ_API_KEY=
GEMINI_API_KEY=
# Must match MUHR_SELLER_KEY_<SELLER_ID> on the registry (required outside DEMO).
# MUHR_SELLER_KEY=
